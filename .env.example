# Copy this file to ".env" and fill in the values for the path you use.
# Keys/tokens are read ONLY on the server and are never sent to the browser.
#
# The shipped DEFAULT_MODELS (src/pricing.js) route ALL THREE slots through
# Google Agent Platform / Vertex. That path uses the two settings below:

# --- Google Agent Platform / Vertex (the default path) ---------------------
# API key for the Gemini slots (publisher=google). aiplatform.googleapis.com
AGENT_PLATFORM_API_KEY=

# OAuth bearer token for the Claude slot (publisher=anthropic, :rawPredict).
# OPTIONAL: by default the server AUTO-MINTS this from gcloud on demand and
# refreshes it (see src/gcloudToken.js), so you normally leave this blank and
# just stay logged in with `gcloud auth login`. Set it only if you disable
# auto-mint (GCLOUD_TOKEN_AUTOMINT=0) or want a static fallback for when
# minting fails. A value here is used only as that fallback.
CLAUDE_BEARER_TOKEN=

# GCP project that has the Anthropic models enabled in Vertex Model Garden.
# (Falls back to a hardcoded default in code if unset — set it explicitly.)
GCP_PROJECT_ID=

# --- Direct provider APIs (only if you reconfigure a slot in the UI) --------
# Used by the direct gemini/openai/anthropic adapters. NOT used by the
# Agent Platform defaults above.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- External (non-Vertex) catalog models -----------------------------------
# GPT-5.6 Luna uses OPENAI_API_KEY above; Kimi K3 uses the Moonshot key below.
# Both call the vendor's own API, so running them sends the prompt OUTSIDE
# Google infrastructure. Users can also supply these per-browser under
# "Your API keys" instead of setting them here.
MOONSHOT_API_KEY=

# --- Network exposure ------------------------------------------------------
# HOST=0.0.0.0                # bind address. 0.0.0.0 = whole LAN/internet (default);
#                             # set 127.0.0.1 for localhost-only.

# --- Authentication / login (src/auth.js) ---------------------------------
# Login is ALWAYS on. The first visit prompts you to create the "admin" password
# using a one-time SETUP CODE printed in this server's console on first launch.
# Users persist to ./.auth/users.json (gitignored). Sessions are in-memory.
#
# COOKIE_SECURE=1             # force the Secure flag on session cookies. Leave unset to
#                             # auto-detect HTTPS (set 1 when behind a TLS proxy; the
#                             # cookie is Secure automatically when the request is https).
# ADMIN_USERNAME=admin        # first-account username (default: admin)
# MIN_PASSWORD_LEN=10         # minimum password length (default 10; raise for internet exposure)
# SESSION_TTL_HOURS=8         # idle session lifetime in hours (sliding; default 8)
# LOGIN_MAX_FAILS=5           # failed logins before lockout kicks in (default 5)
# SETUP_CODE=                 # pre-set the first-run setup code instead of a random one
# AUTH_DATA_DIR=./.auth       # where users.json is stored
# APP_DATA_DIR=               # durable app data root (per-user run history goes in <dir>/history).
#                             # In the cloud this is a GCS bucket mounted as a volume so history
#                             # survives restarts; unset = local ./.data (gitignored).
# --- Break-glass admin (durable password login; recommended in the cloud) ---
# If set, a durable admin account is (re)created on every startup from this value.
# It survives Cloud Run's ephemeral filesystem, so you always have a username/
# password way in even if Google sign-in is down or your account is locked out.
# Store the value in Secret Manager, not here. Skipped if shorter than MIN_PASSWORD_LEN.
# ADMIN_BOOTSTRAP_PASSWORD=    # password for the break-glass admin (login user = ADMIN_USERNAME)
# ADMIN_BOOTSTRAP_USERNAME=admin   # optional; defaults to ADMIN_USERNAME (admin)
# TRUST_PROXY=1               # trust X-Forwarded-* from a reverse proxy/tunnel (default OFF; set 1 behind Cloud Run/nginx)

# --- Org SSO: "Sign in with Google" (src/googleAuth.js) --------------------
# Any user in your Google Workspace domain(s) logs in with one click — no per-user
# passwords. OFF unless both CLIENT_ID and CLIENT_SECRET are set. See DEPLOYMENT.md.
# GOOGLE_CLIENT_ID=            # OAuth 2.0 Web client ID
# GOOGLE_CLIENT_SECRET=        # OAuth 2.0 Web client secret
# ALLOWED_EMAIL_DOMAINS=example.com   # comma list; only these domains may sign in
# ADMIN_EMAILS=you@example.com        # comma list of emails granted the admin role
# OAUTH_REDIRECT_BASE=https://your-app-url   # public base URL; callback = /auth/google/callback

# --- Abuse guardrail: per-user daily comparison limit ----------------------
# MAX_RUNS_PER_DAY=20         # comparisons each user may run per day (0 = unlimited)
# RATE_LIMIT_EXEMPT_ADMINS=1  # 1 = admins exempt from the daily limit (default)

# --- In-browser games (GUI/Pygame tasks like Mario) ------------------------
# GUI tasks build to WebAssembly via pygbag and run IN THE BROWSER (so they work
# for remote users, not just on the server's screen). Requires Python + pygbag on
# the server host:  pip install pygbag
# ENABLE_WEB_GAME=0           # set to 0 to disable the in-browser game build
# WEB_GAME_BUILD_TIMEOUT_SEC=240   # max seconds for a pygbag build (default 240)

# --- Optional tuning -------------------------------------------------------
# CLAUDE_EFFORT=high          # Vertex Claude adaptive-thinking effort (default: high)
# MAX_OUTPUT_TOKENS=0         # 0 = uncapped (each model uses its own max)
# PORT=8080                   # server port (default 8080)

# --- Claude token auto-mint (src/gcloudToken.js) ---------------------------
# GCLOUD_TOKEN_AUTOMINT=0          # set to 0 to disable auto-mint and use the static CLAUDE_BEARER_TOKEN above
# GCLOUD_TOKEN_CMD=gcloud auth print-access-token   # override the mint command
# GCLOUD_TOKEN_TTL_SEC=3000        # cache lifetime before re-minting (default 3000s / 50 min)
